{
    "help": {
        "returns": "component",
        "componentName": "Help",
        "parameters": {}
    },
    "ls": {
        "returns": "component",
        "componentName": "Ls",
        "injectConstant": { "paramKey": "list", "constantName": "ls_home" }
    },
    "whoami": {
        "returns": "text",
        "readStore": "username"
    },
    "clear": {
        "updateStore": "clear",
        "storeValue": true,
        "returns": "empty"
    },
    "rm": {
        "returns": "component",
        "componentName": "ErrorCodes",
        "parameters": {
            "codeType": "ERROR",
            "code": "LOL"
        },
        "defaultArg": "",
        "messageTemplate": "Get good nerd."
    },
    "username": {
        "argRegex": "username (\\w+)",
        "defaultArg": "visitor",
        "updateStore": "username",
        "returns": "component",
        "componentName": "ErrorCodes",
        "parameters": {
            "codeType": "SUCCESS",
            "code": ""
        },
        "messageTemplate": "Username changed to {arg}"
    }
}