{
    "~/home": {
        "blogs/": {
            "type": "directory"
        },
        "projects/": {
            "type": "directory"
        },
        "about.md": {
            "type": "modal",
            "doc": "about",
            "docPath": "/src/lib/docs/about.svx"
        },
        "contact.md": {
            "type": "modal",
            "doc": "contact",
            "docPath": "/src/lib/docs/contact.svx"
        },
        "github/": {
            "type": "link",
            "href": "https://github.com/Just-Another-Damned-Coder"
        }
    },
    "~/home/blogs": {
        "my-first-post.md": {
            "type": "modal",
            "doc": "blogs/sample.md"
        },
        "terminal-tutorial.md": {
            "type": "modal",
            "doc": "blogs/sample.md"
        },
        "..": {
            "type": "directory",
            "target": "~/home"
        }
    },
    "~/home/projects": {
        "portfolio-site/": {
            "type": "link",
            "href": "https://github.com/..."
        },
        "..": {
            "type": "directory",
            "target": "~/home"
        }
    }
}